@page
@model ST10174327_GiftOfTheGiversWebApp.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-7 col-md-8">
            <div class="card border-0 shadow-lg my-5">
                <div class="card-body p-5">
                    <!-- Logo/Brand Section -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: linear-gradient(45deg, #28a745, #218838); border-radius: 50%;">
                            <i class="fas fa-user-plus fa-2x text-white"></i>
                        </div>
                        <h2 class="fw-bold text-dark mb-2">Join Our Community</h2>
                        <p class="text-muted">Create your account to start making a difference</p>
                    </div>

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Please correct the following errors:</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>

                    <!-- Registration Form -->
                    <form id="registerForm" asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.FirstName" class="form-control form-control-lg" autocomplete="given-name" aria-required="true" placeholder="John" />
                                    <label asp-for="Input.FirstName" class="form-label">
                                        <i class="fas fa-user me-2"></i>First Name
                                    </label>
                                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.LastName" class="form-control form-control-lg" autocomplete="family-name" aria-required="true" placeholder="Doe" />
                                    <label asp-for="Input.LastName" class="form-label">
                                        <i class="fas fa-user me-2"></i>Last Name
                                    </label>
                                    <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label">
                                <i class="fas fa-envelope me-2"></i>Email Address
                            </label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.UserName" class="form-control form-control-lg" autocomplete="username" aria-required="true" placeholder="username" />
                            <label asp-for="Input.UserName" class="form-label">
                                <i class="fas fa-user-tag me-2"></i>Username
                            </label>
                            <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                Choose a unique username (3-50 characters). If left blank, your email will be used.
                            </small>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label">
                                <i class="fas fa-lock me-2"></i>Password
                            </label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                Password must be at least 6 characters long and contain uppercase, lowercase, and numbers.
                            </small>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.ConfirmPassword" class="form-label">
                                <i class="fas fa-lock me-2"></i>Confirm Password
                            </label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-4">
                            <button id="registerSubmit" type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-user-plus me-2"></i>Create Account
                            </button>
                        </div>

                        <!-- External Login Providers -->
                        @if (Model.ExternalLogins?.Count > 0)
                        {
                            <div class="text-center mb-3">
                                <div class="border-top pt-3">
                                    <small class="text-muted">Or register with</small>
                                </div>
                            </div>
                            <div class="row g-2 mb-4">
                                @foreach (var provider in Model.ExternalLogins)
                                {
                                    <div class="col-12">
                                        <a asp-area="Identity"
                                           asp-page="/Account/ExternalLogin"
                                           asp-route-provider="@provider.Name"
                                           asp-route-returnUrl="@Model.ReturnUrl"
                                           class="btn btn-outline-secondary btn-lg w-100">
                                            <i class="fab fa-@provider.Name.ToLower() me-2"></i>
                                            @provider.DisplayName
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Login Link -->
                        <div class="text-center">
                            <p class="mb-0">
                                Already have an account?
                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="text-decoration-none fw-bold text-success">
                                    <i class="fas fa-sign-in-alt me-1"></i>Sign in here
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Benefits Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title text-center mb-3">
                        <i class="fas fa-star text-warning me-2"></i>Why Join Us?
                    </h5>
                    <div class="row text-center">
                        <div class="col-md-4 mb-3">
                            <i class="fas fa-exclamation-triangle fa-2x text-primary mb-2"></i>
                            <h6>Report Disasters</h6>
                            <small class="text-muted">Help identify areas in need</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <i class="fas fa-gift fa-2x text-success mb-2"></i>
                            <h6>Make Donations</h6>
                            <small class="text-muted">Support relief efforts</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <i class="fas fa-users fa-2x text-info mb-2"></i>
                            <h6>Volunteer</h6>
                            <small class="text-muted">Join our community</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom Styles -->
<style>
    .form-control:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
    }

    .btn-success {
        background: linear-gradient(45deg, #28a745, #218838);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background: linear-gradient(45deg, #218838, #28a745);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.4);
        }

    .btn-outline-secondary {
        border: 2px solid #6c757d;
        transition: all 0.3s ease;
    }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            border-color: #6c757d;
            transform: translateY(-1px);
        }

    .text-success {
        color: #28a745 !important;
    }

    .alert-danger {
        border-left: 4px solid #dc3545;
    }

    .form-text {
        font-size: 0.875rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
