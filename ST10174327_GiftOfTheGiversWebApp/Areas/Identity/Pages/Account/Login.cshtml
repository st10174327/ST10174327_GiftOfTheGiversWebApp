@page
@using ST10174327_GiftOfTheGiversWebApp.Areas.Identity.Pages.Account
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-7 col-md-8">
            <div class="card border-0 shadow-lg my-5">
                <div class="card-body p-5">
                    <!-- Logo/Brand Section -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background: linear-gradient(45deg, #dc3545, #c82333); border-radius: 50%;">
                            <i class="fas fa-hands-helping fa-2x text-white"></i>
                        </div>
                        <h2 class="fw-bold text-dark mb-2">Welcome Back</h2>
                        <p class="text-muted">Sign in to your Gift of the Givers account</p>
                    </div>

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Please correct the following errors:</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>

                    <!-- Login Form -->
                    <form id="account" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="user">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.UserName" class="form-control form-control-lg" autocomplete="username" aria-required="true" placeholder="Username" />
                            <label asp-for="Input.UserName" class="form-label">
                                <i class="fas fa-user me-2"></i>Username
                            </label>
                            <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password" aria-required="true" placeholder="Password" />
                            <label asp-for="Input.Password" class="form-label">
                                <i class="fas fa-lock me-2"></i>Password
                            </label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="Input.RememberMe" />
                                    <label class="form-check-label" asp-for="Input.RememberMe">
                                        Remember me
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6 text-end">
                                <a class="text-decoration-none" id="forgot-password" asp-area="Identity" asp-page="/Account/ForgotPassword">
                                    <small>Forgot your password?</small>
                                </a>
                            </div>
                        </div>

                        <div class="d-grid mb-4">
                            <button id="login-submit" type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Sign In
                            </button>
                        </div>

                        <!-- External Login Providers -->
                        @if (Model.ExternalLogins?.Count > 0)
                        {
                            <div class="text-center mb-3">
                                <div class="border-top pt-3">
                                    <small class="text-muted">Or sign in with</small>
                                </div>
                            </div>
                            <div class="row g-2 mb-4">
                                @foreach (var provider in Model.ExternalLogins)
                                {
                                    <div class="col-12">
                                        <a asp-area="Identity"
                                           asp-page="/Account/ExternalLogin"
                                           asp-route-provider="@provider.Name"
                                           asp-route-returnUrl="@Model.ReturnUrl"
                                           class="btn btn-outline-secondary btn-lg w-100">
                                            <i class="fab fa-@provider.Name.ToLower() me-2"></i>
                                            @provider.DisplayName
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Registration Link -->
                        <div class="text-center">
                            <p class="mb-0">
                                Don't have an account?
                                <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold text-primary">
                                    <i class="fas fa-user-plus me-1"></i>Create one here
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Section -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center p-3">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        Need help? Contact our support team at
                        <a href="mailto:support@giftofthegivers.org" class="text-decoration-none">
                            support@giftofthegivers.org
                        </a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom Styles -->
<style>
    .form-control:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
    }

    .btn-primary {
        background: linear-gradient(45deg, #dc3545, #c82333);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(45deg, #c82333, #dc3545);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        }

    .btn-outline-secondary {
        border: 2px solid #6c757d;
        transition: all 0.3s ease;
    }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            border-color: #6c757d;
            transform: translateY(-1px);
        }

    .text-primary {
        color: #dc3545 !important;
    }

    .alert-danger {
        border-left: 4px solid #dc3545;
    }

    #forgot-password:hover {
        color: #dc3545 !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
