@model IEnumerable<ST10174327_GiftOfTheGiversWebApp.Models.MoneyAllocation>

@{
    ViewData["Title"] = "Money Allocations";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">Money Allocations</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">Create New Allocation</a>
    </div>

    <div class="mb-4">
        <p class="h5">Remaining Money: <strong>@ViewBag.RemainingMoney?.ToString("C") ?? "R0.00"</strong></p>
        <p class="h5">Total Allocated: <strong>@ViewBag.Total?.ToString("C") ?? "R0.00"</strong></p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No allocations have been made yet.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Allocation Date</th>
                    <th>Aid Type</th>
                    <th>Allocation Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AllocationDate.ToShortDateString()</td>
                        <td>@item.AidType</td>
                        <td>@item.AllocationAmount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
