@model ST10174327_GiftOfTheGiversWebApp.Models.VolunteerTask
@{
    ViewData["Title"] = "Create New Task";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create New Volunteer Task</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateTask" method="post" novalidate>
                        @* Row: Title & Category *@
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Title" class="form-label">Task Title *</label>
                                <input asp-for="Title" class="form-control" placeholder="Enter task title" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label">Category *</label>
                                <select asp-for="Category" class="form-control">
                                    <option value="">Select Category</option>
                                    <option value="Distribution">Food Distribution</option>
                                    <option value="Medical">Medical Assistance</option>
                                    <option value="Logistics">Logistics</option>
                                    <option value="Education">Education</option>
                                    <option value="Construction">Construction</option>
                                    <option value="Administrative">Administrative</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>
                        </div>

                        @* Description *@
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide task details"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        @* Row: Location & Required Volunteers *@
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TaskLocation" class="form-label">Location *</label>
                                <input asp-for="TaskLocation" class="form-control" placeholder="Enter location" />
                                <span asp-validation-for="TaskLocation" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="RequiredVolunteers" class="form-label">Required Volunteers *</label>
                                <input asp-for="RequiredVolunteers" type="number" min="1" class="form-control" />
                                <span asp-validation-for="RequiredVolunteers" class="text-danger"></span>
                            </div>
                        </div>

                        @* Row: Start & End Dates *@
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label">Start Date *</label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label">End Date *</label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        @* Skills Required *@
                        <div class="mb-3">
                            <label asp-for="SkillsRequired" class="form-label">Skills Required</label>
                            <input asp-for="SkillsRequired" class="form-control" placeholder="e.g., First Aid, Driving, Cooking" />
                            <span asp-validation-for="SkillsRequired" class="text-danger"></span>
                        </div>

                        @* Buttons *@
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Create Task</button>
                            <a asp-action="Tasks" class="btn btn-secondary btn-lg">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
