@model ST10174327_GiftOfTheGiversWebApp.Models.ViewModels.AdminDashboardVM

@{
    ViewData["Title"] = "Volunteer Management Dashboard";
}

<div class="container-fluid mt-4">
    <!-- Header with Quick Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Volunteer Management Dashboard</h1>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CreateTask")" class="btn btn-success">
                <i class="fas fa-plus me-1"></i> Create New Task
            </a>
            <a href="@Url.Action("Volunteers")" class="btn btn-primary">
                <i class="fas fa-users me-1"></i> Manage Volunteers
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">@Model.TotalVolunteers</h4>
                        <p class="mb-0">Total Volunteers</p>
                    </div>
                    <i class="fas fa-users fa-2x"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">@Model.ActiveTasks</h4>
                        <p class="mb-0">Active Tasks</p>
                    </div>
                    <i class="fas fa-tasks fa-2x"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">@Model.CompletedTasks</h4>
                        <p class="mb-0">Completed Tasks</p>
                    </div>
                    <i class="fas fa-check-circle fa-2x"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">@Model.RecentRegistrations.Count</h4>
                        <p class="mb-0">New Registrations</p>
                    </div>
                    <i class="fas fa-user-plus fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row">
        <!-- Recent Registrations -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Recent Volunteer Registrations</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentRegistrations.Any())
                    {
                        <div class="list-group">
                            @foreach (var volunteer in Model.RecentRegistrations)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@volunteer.Name</h6>
                                        <small class="text-muted">@volunteer.Email</small>
                                    </div>
                                    <span class="badge bg-success">@volunteer.RegistrationDate.ToString("MMM dd")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No recent registrations</p>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body d-grid gap-3">
                    <a href="@Url.Action("Tasks")" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-tasks me-2"></i> View All Tasks
                    </a>
                    <a href="@Url.Action("Volunteers")" class="btn btn-outline-success btn-lg">
                        <i class="fas fa-users me-2"></i> Manage Volunteers
                    </a>
                    <a href="@Url.Action("CreateTask")" class="btn btn-outline-info btn-lg">
                        <i class="fas fa-plus me-2"></i> Create New Task
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
