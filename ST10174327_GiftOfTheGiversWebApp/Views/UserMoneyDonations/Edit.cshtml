@model ST10174327_GiftOfTheGiversWebApp.Models.MoneyDonation

<div class="container mt-4">
    <h3 class="mb-3">Edit Donation</h3>
    <hr />

    <p class="text-muted mb-3">
        Update the details of the donation below. Ensure the information is accurate before saving.
    </p>

    <form asp-action="Edit" class="needs-validation" novalidate>
        <input type="hidden" asp-for="MONEY_DONATION_ID" />

        <div class="mb-3">
            <label asp-for="DATE" class="form-label">Donation Date</label>
            <input asp-for="DATE" class="form-control" type="date" />
            <span asp-validation-for="DATE" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AMOUNT" class="form-label">Donation Amount</label>
            <input asp-for="AMOUNT" class="form-control" type="number" step="0.01" min="1" />
            <span asp-validation-for="AMOUNT" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DONOR" class="form-label">Donor</label>
            <input asp-for="DONOR" class="form-control" />
            <span asp-validation-for="DONOR" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary me-2">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>

    <p class="text-muted mt-3">
        After saving, the updated donation will be reflected in the donation list. If you do not want to make changes, click "Back to List."
    </p>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
