@model ST10174327_GiftOfTheGiversWebApp.Models.MoneyDonation

@{
    ViewData["Title"] = "Donate Money";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">Donate Money</h2>
    <hr />

    <p class="text-muted mb-4">
        Your monetary donations help us provide timely assistance to those in need. Please fill in the details below to contribute, either anonymously or with your name attached. All contributions are tracked securely for transparency and accountability.
    </p>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Create" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="USERNAME" type="hidden" value="@User.Identity.Name" />

                <div class="mb-3">
                    <label asp-for="DATE" class="form-label">Donation Date</label>
                    <input asp-for="DATE" class="form-control" type="date" />
                    <span asp-validation-for="DATE" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AMOUNT" class="form-label">Amount (ZAR)</label>
                    <input asp-for="AMOUNT" class="form-control" type="number" step="0.01" min="1" placeholder="Enter the donation amount" />
                    <span asp-validation-for="AMOUNT" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DONOR" class="form-label">Donor Type</label><br />
                    <input type="radio" asp-for="DONOR" name="DONOR" value="Anonymous" /> Anonymous
                    <input type="radio" asp-for="DONOR" name="DONOR" value="@User.Identity.Name" checked /> Myself
                    <span asp-validation-for="DONOR" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-start">
                    <button type="submit" class="btn btn-primary me-2">Donate</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>

    <p class="text-muted mt-4">
        All donations are securely processed and acknowledged. Choosing to donate anonymously ensures your privacy, while donating with your name helps us recognize your contribution publicly if you wish.
    </p>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
