@model ST10174327_GiftOfTheGiversWebApp.Models.MoneyDonation

<div class="container mt-4">
    <h3 class="text-danger mb-3">Confirm Deletion of Donation</h3>
    <hr />

    <p class="text-muted mb-3">
        You are about to permanently delete this monetary donation record. This action cannot be undone. Please review the donation details below carefully before proceeding.
    </p>

    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DATE)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.DATE)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.AMOUNT)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.AMOUNT)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DONOR)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.DONOR)</dd>
    </dl>

    <div class="d-flex justify-content-start mt-3">
        <form asp-action="Delete" class="me-2">
            <input type="hidden" asp-for="MONEY_DONATION_ID" />
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>

    <p class="text-muted mt-3">
        If you choose to delete, this donation record will be removed from the system permanently. Consider contacting an administrator if you are unsure.
    </p>
</div>
