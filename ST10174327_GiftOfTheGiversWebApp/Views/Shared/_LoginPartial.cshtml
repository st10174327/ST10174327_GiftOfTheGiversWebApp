@using Microsoft.AspNetCore.Identity
@using Microsoft.Identity.Web
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject Microsoft.Identity.Web.ITokenAcquisition TokenAcquisition

<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link text-light">Welcome @User.Identity.Name</span>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="GoodsDonations" asp-action="Index">Goods Donations</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="MoneyDonations" asp-action="Index">Money Donations</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="Disasters" asp-action="Index">Disasters</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="MoneyAllocations" asp-action="Index">Allocate money to disaster</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="GoodsAllocations" asp-action="Index">Allocate goods to disaster</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="GoodsPurchases" asp-action="Index">Purchase goods</a>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="UserGoodsDonations" asp-action="Index">Goods Donations</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="UserMoneyDonations" asp-action="Index">Money Donations</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-light" asp-area="" asp-controller="UserDisasters" asp-action="Index">Disasters</a>
            </li>
        }

        <li class="nav-item">
            @if (User.Claims.Any(c => c.Issuer == "https://login.microsoftonline.com/" || c.Issuer == "https://sts.windows.net/"))
            {
                <a class="nav-link text-light" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">Sign out (Azure AD)</a>
            }
            else
            {
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="nav-link btn btn-link text-light">Logout</button>
                </form>
            }
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login">Local Login</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-light" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">Sign in with Microsoft</a>
        </li>
    }
</ul>