@model ST10174327_GiftOfTheGiversWebApp.Models.GoodsDonation

<div class="container mt-4">
    <h2 class="mb-3">Edit Goods Donation</h2>
    <hr />

    <p class="text-muted">
        Use this form to update the details of the donation. Ensure that all information is accurate before saving the changes. Fields marked with an asterisk (*) are required.
    </p>

    <form asp-action="Edit" class="needs-validation" novalidate>
        <input type="hidden" asp-for="GOODS_DONATION_ID" />

        <div class="mb-3">
            <label asp-for="DATE" class="form-label"></label>
            <input asp-for="DATE" class="form-control" type="date" required />
            <span asp-validation-for="DATE" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ITEM_COUNT" class="form-label"></label>
            <input asp-for="ITEM_COUNT" class="form-control" type="number" min="1" required />
            <span asp-validation-for="ITEM_COUNT" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CATEGORY" class="form-label"></label>
            <select asp-for="CATEGORY" class="form-select" required>
                <option value="">-- Select a Category --</option>
                <option value="Cloths">Cloths</option>
                <option value="Non-Perishable Foods">Non-Perishable Foods</option>
                @if (ViewBag.CategoryList is List<string> categoryList && categoryList.Any())
                {
                    foreach (var category in categoryList)
                    {
                        if (Model.CATEGORY == category)
                        {
                            <option value="@category" selected>@category</option>
                        }
                        else
                        {
                            <option value="@category">@category</option>
                        }
                    }
                }
            </select>
            <span asp-validation-for="CATEGORY" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DESCRIPTION" class="form-label"></label>
            <textarea asp-for="DESCRIPTION" class="form-control" rows="3" placeholder="Add additional details about the donation if necessary."></textarea>
            <span asp-validation-for="DESCRIPTION" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DONOR" class="form-label">Donor</label>
            <input type="text" asp-for="DONOR" class="form-control" placeholder="Enter donor name or select 'Anonymous'" />
            <span asp-validation-for="DONOR" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>

        <small class="text-muted mt-2 d-block">
            Updating the donation allows you to correct information such as item count, category, or donor details. Please verify the information carefully before saving.
        </small>
    </form>
</div> 

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Optional: Additional client-side validation for numeric fields
        $(document).ready(function() {
            $("input[type='number']").on("input", function() {
                var value = $(this).val();
                if (value < 1) $(this).val(1);
            });
        });
    </script>
}