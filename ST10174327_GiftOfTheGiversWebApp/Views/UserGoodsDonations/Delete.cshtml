@model ST10174327_GiftOfTheGiversWebApp.Models.GoodsDonation

<div class="container mt-4">
    <h3 class="text-danger">Confirm Deletion of Donation</h3>
    <hr />

    <p class="text-muted">
        Please review the details below carefully before confirming deletion. This action is irreversible and will permanently remove this goods donation from the system.
    </p>

    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DATE)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.DATE)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.ITEM_COUNT)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.ITEM_COUNT)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CATEGORY)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.CATEGORY)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DESCRIPTION)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.DESCRIPTION)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DONOR)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.DONOR)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="GOODS_DONATION_ID" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>

    <div class="mt-3">
        <p class="text-muted small">
            Deleting this record will remove all associated information, including donor details and donation date. Ensure that you have confirmed this action with any stakeholders if necessary.
        </p>
    </div>
</div>
