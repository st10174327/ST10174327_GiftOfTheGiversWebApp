@model IEnumerable<ST10174327_GiftOfTheGiversWebApp.Models.GoodsAllocation>

@{
    ViewData["Title"] = "Goods Allocations";
}

<div class="container my-5">

    @* Success message alert *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">Goods Allocations</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="fas fa-plus me-2"></i>Create New Allocation
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Item Count</th>
                        <th>Category</th>
                        <th>Allocation Date</th>
                        <th>Aid Type</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ITEM_COUNT</td>
                            <td>@item.CATEGORY</td>
                            <td>@item.AllocationDate?.ToString("MMM dd, yyyy")</td>
                            <td>@item.AidType</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-boxes fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No Goods Allocations Yet</h5>
            <p class="text-muted">Start by creating a new allocation to track disaster relief efforts.</p>
            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="fas fa-plus me-2"></i>Create Allocation
            </a>
        </div>
    }
</div>
