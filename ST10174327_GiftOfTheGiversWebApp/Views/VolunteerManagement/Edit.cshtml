@model ST10174327_GiftOfTheGiversWebApp.Models.Volunteer
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Volunteer Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Determine if current user is Admin or the owner of this volunteer record
    var currentUsername = UserManager.GetUserName(User);
    var isAuthorized = User.IsInRole("Admin") || Model.Email == currentUsername;
}

<div class="container mt-4">
    <h2>Volunteer Details</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Phone Number</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>

        <dt class="col-sm-3">Registration Date</dt>
        <dd class="col-sm-9">@Model.RegistrationDate.ToString("dd MMM yyyy")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Active</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Yes</span>
            }
            else
            {
                <span class="badge bg-secondary">No</span>
            }
        </dd>

        @if (!string.IsNullOrEmpty(Model.Address))
        {
            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@Model.Address</dd>
        }

        @if (!string.IsNullOrEmpty(Model.Skills))
        {
            <dt class="col-sm-3">Skills</dt>
            <dd class="col-sm-9">@Model.Skills</dd>
        }

        @if (!string.IsNullOrEmpty(Model.Availability))
        {
            <dt class="col-sm-3">Availability</dt>
            <dd class="col-sm-9">@Model.Availability</dd>
        }

        @if (!string.IsNullOrEmpty(Model.EmergencyContact))
        {
            <dt class="col-sm-3">Emergency Contact</dt>
            <dd class="col-sm-9">@Model.EmergencyContact</dd>
        }
    </dl>

    @if (isAuthorized)
    {
        <a asp-action="Edit" asp-route-id="@Model.VolunteerID" class="btn btn-primary">Edit</a>
    }

    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</div>