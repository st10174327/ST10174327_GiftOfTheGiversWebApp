@model ST10174327_GiftOfTheGiversWebApp.Models.Volunteer

@{
    ViewData["Title"] = "Register as Volunteer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-user-plus me-2"></i>
                        Register as a Volunteer
                    </h4>
                    <small class="text-white-50">Join our team and make a real difference in disaster relief</small>
                </div>

                <div class="card-body p-4">
                    <!-- Success/Error Messages -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (ViewData.ModelState.Any(x => x.Key == "") && ViewData.ModelState[""].Errors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @ViewData.ModelState[""].Errors.FirstOrDefault()?.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-8">
                            <p class="text-muted mb-4">
                                By registering as a volunteer, you'll have access to volunteer opportunities,
                                task assignments, and the ability to contribute directly to disaster relief efforts.
                                Your skills and availability will help us coordinate effective responses.
                            </p>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="bg-light rounded p-3">
                                <i class="fas fa-hands-helping fa-3x text-success mb-2"></i>
                                <p class="small text-muted mb-0">Be the change</p>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Register" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Hidden fields -->
                        <input asp-for="Email" type="hidden" value="@(User.Identity?.Name ?? "")" />
                        <input asp-for="RegistrationDate" type="hidden" value="@DateTime.Now" />
                        <input asp-for="Status" type="hidden" value="Active" />

                        <!-- Personal Information -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-bold">
                                    <i class="fas fa-user me-1"></i>Full Name
                                </label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Enter your full name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">
                                    <i class="fas fa-phone me-1"></i>Phone Number
                                </label>
                                <input asp-for="PhoneNumber" class="form-control form-control-lg" placeholder="e.g., +27 123 456 789" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Address -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">
                                <i class="fas fa-map-marker-alt me-1"></i>Address (Optional)
                            </label>
                            <textarea asp-for="Address" class="form-control" rows="2"
                                      placeholder="Enter your address for coordination purposes"></textarea>
                            <div class="form-text">Your address helps us assign you to local disaster response efforts</div>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <!-- Emergency Contact -->
                        <div class="mb-3">
                            <label asp-for="EmergencyContact" class="form-label fw-bold">
                                <i class="fas fa-phone-volume me-1"></i>Emergency Contact
                            </label>
                            <input asp-for="EmergencyContact" class="form-control form-control-lg"
                                   placeholder="Name and phone number of emergency contact" />
                            <div class="form-text">In case of emergencies during volunteer activities</div>
                            <span asp-validation-for="EmergencyContact" class="text-danger"></span>
                        </div>

                        <!-- Skills -->
                        <div class="mb-3">
                            <label asp-for="Skills" class="form-label fw-bold">
                                <i class="fas fa-tools me-1"></i>Skills & Expertise
                            </label>
                            <textarea asp-for="Skills" class="form-control" rows="3"
                                      placeholder="List your skills, experience, and areas of expertise (e.g., first aid, logistics, construction, counseling, etc.)"></textarea>
                            <div class="form-text">Your skills help us match you with appropriate volunteer tasks</div>
                            <span asp-validation-for="Skills" class="text-danger"></span>
                        </div>

                        <!-- Availability -->
                        <div class="mb-4">
                            <label asp-for="Availability" class="form-label fw-bold">
                                <i class="fas fa-clock me-1"></i>Availability
                            </label>
                            <select asp-for="Availability" class="form-select form-select-lg">
                                <option value="">-- Select your availability --</option>
                                <option value="Weekdays Only">📅 Weekdays Only</option>
                                <option value="Weekends Only">🌅 Weekends Only</option>
                                <option value="Evenings">🌙 Evenings</option>
                                <option value="Full Time">⏰ Full Time Available</option>
                                <option value="Part Time">🕒 Part Time Available</option>
                                <option value="As Needed">📞 As Needed Basis</option>
                                <option value="Emergency Response Only">🚨 Emergency Response Only</option>
                            </select>
                            <div class="form-text">Let us know when you're available for volunteer activities</div>
                            <span asp-validation-for="Availability" class="text-danger"></span>
                        </div>

                        <!-- Agreement -->
                        <div class="alert alert-info">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="agreement" required />
                                <label class="form-check-label" for="agreement">
                                    <strong>I agree to volunteer with the Gift of the Givers Foundation</strong> and understand that I may be called upon to assist in disaster relief efforts. I confirm that all information provided is accurate and I am willing to participate in volunteer activities as needed.
                                </label>
                            </div>
                        </div>

                        <!-- Benefits -->
                        <div class="alert alert-success">
                            <h6><i class="fas fa-star me-2"></i>Volunteer Benefits</h6>
                            <ul class="mb-0">
                                <li>Direct involvement in disaster relief efforts</li>
                                <li>Access to volunteer training and resources</li>
                                <li>Recognition for your contributions</li>
                                <li>Networking with other volunteers</li>
                                <li>Certificate of appreciation for your service</li>
                            </ul>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg me-md-2">
                                <i class="fas fa-arrow-left me-1"></i>Back to Volunteer Management
                            </a>
                            <button type="submit" class="btn btn-success btn-lg" id="submitBtn">
                                <i class="fas fa-user-plus me-2"></i>Register as Volunteer
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Section -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body text-center p-3">
                    <small class="text-muted">
                        <i class="fas fa-question-circle me-1"></i>
                        Have questions about volunteering? Contact our volunteer coordinator at
                        <a href="mailto:volunteers@giftofthegivers.org" class="text-decoration-none">
                            volunteers@giftofthegivers.org
                        </a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
    }

    .btn-success {
        background: linear-gradient(45deg, #28a745, #218838);
        border: none;
        transition: all 0.3s ease;
    }

    .btn-success:hover {
        background: linear-gradient(45deg, #218838, #28a745);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(40, 167, 69, 0.4);
    }

    .btn-success:disabled {
        background: #6c757d;
        transform: none;
        box-shadow: none;
    }

    .alert-info {
        border-left: 4px solid #0dcaf0;
        background-color: #f8f9fa;
    }

    .alert-success {
        border-left: 4px solid #28a745;
    }

    .form-check-input:checked {
        background-color: #28a745;
        border-color: #28a745;
    }

    #agreement:invalid + label {
        color: #dc3545;
    }

    #agreement:valid + label {
        color: #212529;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Enable/disable submit button based on agreement checkbox
        document.getElementById('agreement').addEventListener('change', function() {
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = !this.checked;
        });

        // Auto-hide success message
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            setTimeout(function() {
                const alert = document.querySelector('.alert-success');
                if (alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            }, 5000);
            </text>
        }

        // Form validation enhancements
        document.querySelector('form').addEventListener('submit', function(e) {
            const agreement = document.getElementById('agreement');
            if (!agreement.checked) {
                e.preventDefault();
                agreement.focus();
                alert('Please agree to the volunteer terms before registering.');
                return false;
            }

            // Show loading state
            const submitBtn = document.getElementById('submitBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Registering...';
            }

            return true;
        });
    </script>
}
