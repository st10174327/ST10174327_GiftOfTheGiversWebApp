@model Microsoft.Graph.User
@{
    ViewData["Title"] = "User Profile";
    var photo = ViewData["Photo"] as string;
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(photo))
                    {
                        <img src="data:image/jpeg;base64,@photo" class="rounded-circle img-thumbnail" style="width: 200px; height: 200px;" alt="Profile Picture" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 200px; height: 200px; margin: 0 auto;">
                            <span class="display-4 text-white">@Model.DisplayName?[0]</span>
                        </div>
                    }
                    <h4 class="mt-3">@Model.DisplayName</h4>
                    <p class="text-muted">@Model.UserPrincipalName</p>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Profile Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Display Name</dt>
                        <dd class="col-sm-8">@Model.DisplayName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Mail</dd>

                        <dt class="col-sm-4">Job Title</dt>
                        <dd class="col-sm-8">@(Model.JobTitle ?? "Not specified")</dd>

                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">@(Model.Department ?? "Not specified")</dd>

                        <dt class="col-sm-4">Mobile Phone</dt>
                        <dd class="col-sm-8">@(Model.MobilePhone ?? "Not specified")</dd>

                        <dt class="col-sm-4">Office Location</dt>
                        <dd class="col-sm-8">@(Model.OfficeLocation ?? "Not specified")</dd>
                    </dl>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5>Account Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Last Sign-in</dt>
                        <dd class="col-sm-8">@DateTime.Now.ToString("f")</dd>

                        <dt class="col-sm-4">Authentication Method</dt>
                        <dd class="col-sm-8">
                            @if (User.Claims.Any(c => c.Issuer == "https://login.microsoftonline.com/" || c.Issuer == "https://sts.windows.net/"))
                            {
                                <span class="badge bg-primary">Azure AD</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Local Account</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            margin-bottom: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border: none;
            border-radius: 0.5rem;
        }

        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e3e6f0;
            font-weight: 600;
        }

        dt {
            font-weight: 500;
        }
    </style>
}
