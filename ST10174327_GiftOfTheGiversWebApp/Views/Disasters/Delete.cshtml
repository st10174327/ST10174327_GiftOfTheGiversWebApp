@model ST10174327_GiftOfTheGiversWebApp.Models.Disaster

@{
    ViewData["Title"] = "Delete Disaster";
}

<div class="container my-5">
    <!-- Page header -->
    <div class="text-center mb-5">
        <h1 class="display-4 text-danger">Delete Disaster</h1>
        <p class="text-muted">Are you sure you want to permanently remove this disaster record?</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Disaster details -->
            <dl class="row mb-4">
                <dt class="col-sm-4">Username</dt>
                <dd class="col-sm-8">@Model.USERNAME</dd>

                <dt class="col-sm-4">Start Date</dt>
                <dd class="col-sm-8">@Model.STARTDATE.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-4">End Date</dt>
                <dd class="col-sm-8">@Model.ENDDATE.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-4">Location</dt>
                <dd class="col-sm-8">@Model.LOCATION</dd>

                <dt class="col-sm-4">Aid Type</dt>
                <dd class="col-sm-8">@Model.AID_TYPE</dd>

                <dt class="col-sm-4">Active</dt>
                <dd class="col-sm-8">@(Model.IsActive != 0 ? "Yes" : "No")</dd>
            </dl>

            <!-- Delete form -->
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="DISASTER_ID" />
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="fas fa-trash-alt me-2"></i>Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>