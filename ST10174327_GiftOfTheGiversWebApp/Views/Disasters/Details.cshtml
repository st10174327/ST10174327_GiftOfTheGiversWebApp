@model ST10174327_GiftOfTheGiversWebApp.Models.Disaster

@{
    ViewData["Title"] = "Disaster Details";
}

<div class="container my-5">
    <!-- Page header -->
    <div class="text-center mb-5">
        <h1 class="display-4 text-primary">Disaster Details</h1>
        <p class="text-muted">View detailed information about this disaster record.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Disaster details -->
            <dl class="row mb-4">
                <dt class="col-sm-4">Username</dt>
                <dd class="col-sm-8">@Model.USERNAME</dd>

                <dt class="col-sm-4">Start Date</dt>
                <dd class="col-sm-8">@Model.STARTDATE.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-4">End Date</dt>
                <dd class="col-sm-8">@Model.ENDDATE.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-4">Location</dt>
                <dd class="col-sm-8">@Model.LOCATION</dd>

                <dt class="col-sm-4">Aid Type</dt>
                <dd class="col-sm-8">@Model.AID_TYPE</dd>

                <dt class="col-sm-4">Active</dt>
                <dd class="col-sm-8">@(Model.IsActive != 0 ? "Yes" : "No")</dd>
            </dl>

            <!-- Action buttons -->
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.DISASTER_ID" class="btn btn-success">
                    <i class="fas fa-edit me-2"></i>Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>