@model IEnumerable<ST10174327_GiftOfTheGiversWebApp.Models.Disaster>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 text-primary">Disasters</h1>
        <a asp-action="Create" class="btn btn-primary btn-lg">Log New Disaster</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Username</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Location</th>
                    <th>Aid Type</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td>@item.USERNAME</td>
                            <td>@item.STARTDATE.ToString("MMM dd, yyyy")</td>
                            <td>@item.ENDDATE.ToString("MMM dd, yyyy")</td>
                            <td>@item.LOCATION</td>
                            <td>@item.AID_TYPE</td>
                            <td>
                                <span class="badge @(item.IsActive != 0 ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive != 0 ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.DISASTER_ID" class="btn btn-info btn-sm">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.DISASTER_ID" class="btn btn-success btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.DISASTER_ID" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No disasters logged yet. Click "Log New Disaster" to add one.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>