@model ST10174327_GiftOfTheGiversWebApp.Models.Disaster
@{
    ViewData["Title"] = "Create Disaster";
}

<div class="container my-5">
    <!-- Page header -->
    <div class="text-center mb-5">
        <h1 class="display-4 text-primary">Log a New Disaster</h1>
        <p class="text-muted">Provide accurate details to help us respond effectively.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <!-- Validation summary -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Username -->
                        <div class="mb-3">
                            <label asp-for="USERNAME" class="form-label">Username</label>
                            <input asp-for="USERNAME" class="form-control" placeholder="Enter your username" />
                            <span asp-validation-for="USERNAME" class="text-danger"></span>
                        </div>

                        <!-- Start Date -->
                        <div class="mb-3">
                            <label asp-for="STARTDATE" class="form-label">Start Date *</label>
                            <input asp-for="STARTDATE" type="date" class="form-control" />
                            <span asp-validation-for="STARTDATE" class="text-danger"></span>
                        </div>

                        <!-- End Date -->
                        <div class="mb-3">
                            <label asp-for="ENDDATE" class="form-label">End Date *</label>
                            <input asp-for="ENDDATE" type="date" class="form-control" />
                            <span asp-validation-for="ENDDATE" class="text-danger"></span>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label asp-for="LOCATION" class="form-label">Location *</label>
                            <input asp-for="LOCATION" class="form-control" placeholder="Enter location" />
                            <span asp-validation-for="LOCATION" class="text-danger"></span>
                        </div>

                        <!-- Aid Type -->
                        <div class="mb-3">
                            <label asp-for="AID_TYPE" class="form-label">Aid Type *</label>
                            <input asp-for="AID_TYPE" class="form-control" placeholder="e.g., Food, Medical, Shelter" />
                            <span asp-validation-for="AID_TYPE" class="text-danger"></span>
                        </div>

                        <!-- Is Active -->
                        <div class="form-check mb-4">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Active?</label>
                        </div>

                        <!-- Submit button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-plus me-2"></i>Create Disaster
                            </button>
                        </div>

                        <!-- Back link -->
                        <div class="text-center">
                            <a asp-action="Index" class="btn btn-link">
                                <i class="fas fa-arrow-left me-1"></i>Back to Disaster List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
