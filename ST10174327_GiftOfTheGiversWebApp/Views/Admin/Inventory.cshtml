@model List<ST10174327_GiftOfTheGiversWebApp.Models.GoodsInventory>

@{
    ViewData["Title"] = "Goods Inventory";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Goods Inventory</h1>
                <a href="@Url.Action("Index", "GoodsPurchases")" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Purchase Goods
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Item Count</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CATEGORY</td>
                                <td>@item.ITEM_COUNT</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Allocate", "GoodsAllocations", new { inventoryId = item.GOODS_INVENTORY_ID })" class="btn btn-sm btn-success">
                                            <i class="fas fa-box"></i> Allocate
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
