@model IEnumerable<ST10174327_GiftOfTheGiversWebApp.Models.GoodsDonation>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">Goods Donations</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">Create New Donation</a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Item Count</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Donor</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DATE.ToString("MMM dd, yyyy")</td>
                            <td>@item.ITEM_COUNT</td>
                            <td>@item.CATEGORY</td>
                            <td>@item.DESCRIPTION</td>
                            <td>@item.DONOR</td>
                            <td class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.GOODS_DONATION_ID" class="btn btn-sm btn-primary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.GOODS_DONATION_ID" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.GOODS_DONATION_ID" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <h5>No Goods Donations Found</h5>
            <p class="text-muted">Once donors submit goods, they will appear here.</p>
            <a asp-action="Create" class="btn btn-success btn-lg mt-3">Create First Donation</a>
        </div>
    }
</div>  