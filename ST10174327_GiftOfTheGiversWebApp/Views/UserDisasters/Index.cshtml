@model IEnumerable<ST10174327_GiftOfTheGiversWebApp.Models.Disaster>
@{
    ViewData["Title"] = "Disasters";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Disaster Reports</h2>
    <hr />

    <p>
        <a asp-action="Create" class="btn btn-primary">Report New Disaster</a>
    </p>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Disaster Name</th>
                    <th scope="col">Start Date</th>
                    <th scope="col">End Date</th>
                    <th scope="col">Location</th>
                    <th scope="col">Aid Type</th>
                    <th scope="col">Active Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No disaster reports available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DisasterName</td>
                            <td>@item.STARTDATE.ToString("MMM dd, yyyy")</td>
                            <td>@item.ENDDATE.ToString("MMM dd, yyyy")</td>
                            <td>@item.LOCATION</td>
                            <td>@item.AID_TYPE</td>
                            <td>
                                @if (item.IsActive == 1)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.DISASTER_ID" class="btn btn-sm btn-warning me-1">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.DISASTER_ID" class="btn btn-sm btn-info me-1">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.DISASTER_ID" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <p class="text-muted">
            Use this page to review all reported disasters. You can quickly see key details like the start and end dates, the location, the type of aid required, and whether the disaster report is currently active. Actions on the right allow you to manage each report efficiently by editing details, viewing additional information, or deleting a report if necessary.
        </p>
    </div>
</div>  