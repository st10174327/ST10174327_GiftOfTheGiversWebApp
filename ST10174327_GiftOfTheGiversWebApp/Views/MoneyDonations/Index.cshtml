@model IEnumerable<ST10174327_GiftOfTheGiversWebApp.Models.MoneyDonation>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Money Donations</h1>
        @* Only show Create button for admins *@
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success btn-lg">Create New</a>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Username</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Donor</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.USERNAME</td>
                        <td>@item.DATE?.ToString("dd MMM yyyy")</td>
                        <td>@item.AMOUNT.ToString("C")</td>
                        <td>@item.DONOR</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.MONEY_DONATION_ID" class="btn btn-sm btn-info me-1">Details</a>

                            @* Only show Edit/Delete buttons for admins *@
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.MONEY_DONATION_ID" class="btn btn-sm btn-primary me-1">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.MONEY_DONATION_ID" class="btn btn-sm btn-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>