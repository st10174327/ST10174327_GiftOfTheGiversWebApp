@{
    ViewData["Title"] = "Report a Disaster";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Report a Disaster</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Please provide accurate information about the disaster to help us respond effectively.
                    </div>
                    
                    <form method="post" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="disasterType" class="form-label">Type of Disaster</label>
                            <select class="form-select" id="disasterType" required>
                                <option value="" selected disabled>Select disaster type</option>
                                <option value="flood">Flood</option>
                                <option value="fire">Fire</option>
                                <option value="earthquake">Earthquake</option>
                                <option value="storm">Storm</option>
                                <option value="other">Other</option>
                            </select>
                            <div class="invalid-feedback">
                                Please select a disaster type.
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="location" class="form-label">Location</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                <input type="text" class="form-control" id="location" placeholder="Address or coordinates" required>
                                <div class="invalid-feedback">
                                    Please provide a location.
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="date" class="form-label">Date</label>
                                <input type="date" class="form-control" id="date" required>
                                <div class="invalid-feedback">
                                    Please provide the date of the disaster.
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="time" class="form-label">Time</label>
                                <input type="time" class="form-control" id="time" required>
                                <div class="invalid-feedback">
                                    Please provide the time of the disaster.
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="severity" class="form-label">Severity Level</label>
                            <select class="form-select" id="severity" required>
                                <option value="" selected disabled>Select severity level</option>
                                <option value="low">Low - Minor incident, limited impact</option>
                                <option value="medium">Medium - Significant impact, local response needed</option>
                                <option value="high">High - Major disaster, regional response needed</option>
                                <option value="extreme">Extreme - Catastrophic, national response needed</option>
                            </select>
                            <div class="invalid-feedback">
                                Please select a severity level.
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" rows="4" placeholder="Please provide a detailed description of the disaster, including any immediate needs or hazards." required></textarea>
                            <div class="invalid-feedback">
                                Please provide a description of the disaster.
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="contactName" class="form-label">Your Name</label>
                            <input type="text" class="form-control" id="contactName" required>
                            <div class="invalid-feedback">
                                Please provide your name.
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label for="contactNumber" class="form-label">Contact Number</label>
                            <input type="tel" class="form-control" id="contactNumber" required>
                            <div class="invalid-feedback">
                                Please provide a contact number.
                            </div>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-paper-plane me-2"></i>Submit Report
                            </button>
                        </div>
                    </form>
                    
                    <div class="alert alert-warning mt-4">
                        <h5><i class="fas fa-phone-alt me-2"></i>Emergency Contacts</h5>
                        <ul class="mb-0">
                            <li><strong>Emergency Services:</strong> 10111</li>
                            <li><strong>Ambulance:</strong> 10177</li>
                            <li><strong>Gift of the Givers Emergency Line:</strong> 0800 786 911</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Form validation
        (function () {
            'use strict'
            
            var forms = document.querySelectorAll('.needs-validation')
            
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
        
        // Set default date and time to current
        document.addEventListener('DOMContentLoaded', function() {
            const now = new Date();
            
            // Format date as YYYY-MM-DD
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            document.getElementById('date').value = `${year}-${month}-${day}`;
            
            // Format time as HH:MM
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('time').value = `${hours}:${minutes}`;
        });
    </script>
}
