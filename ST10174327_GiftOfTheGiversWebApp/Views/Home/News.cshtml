@{
    ViewData["Title"] = "News";
}

<div class="container py-5">
    <h1 class="mb-4 text-center fw-bold">Latest News</h1>
    <p class="text-muted text-center mb-5">
        Explore our latest initiatives, relief missions, and inspiring stories of resilience.
    </p>

    <div class="row g-4">

        <!-- News Item 1 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="https://www.goodthingsguy.com/wp-content/uploads/2021/07/mastercard-gift-of-the-givers.jpeg"
                     class="card-img-top" alt="Disaster Relief" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Disaster Relief Mission</h5>
                    <p class="card-text flex-grow-1">
                        Our teams provided urgent aid to families impacted by severe flooding,
                        distributing food, water, and medical supplies.
                    </p>
                    <a href="https://www.instagram.com/reel/DPOTneaDvbz/?utm_source=ig_web_button_share_sheet"
                       target="_blank" class="btn btn-outline-primary mt-auto">See on Instagram</a>
                </div>
            </div>
        </div>

        <!-- News Item 2 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="https://via.placeholder.com/600x400" class="card-img-top" alt="Community March" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Coal Fueling Genocide Protest</h5>
                    <p class="card-text flex-grow-1">
                        Thousands joined the mass march in Cape Town to protest ongoing genocide in Gaza.
                        Citizens demanded that the South African government take a stronger stance.
                    </p>
                    <a href="https://www.instagram.com/reel/DNIAarKxGeg/?utm_source=ig_web_button_share_sheet"
                       target="_blank" class="btn btn-outline-primary mt-auto">See on Instagram</a>
                </div>
            </div>
        </div>

        <!-- News Item 3 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="https://via.placeholder.com/600x400" class="card-img-top" alt="Protest Highlights" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Mass March Highlights</h5>
                    <p class="card-text flex-grow-1">
                        Highlights from the protest against coal trade with Israel, showing strong community participation.
                    </p>
                    <a href="https://www.instagram.com/p/DPOEWpAj_kD/?utm_source=ig_web_button_share_sheet"
                       target="_blank" class="btn btn-outline-primary mt-auto">See on Instagram</a>
                </div>
            </div>
        </div>

    </div>
</div>
